{
  "name": "game-night",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "imports": {
    "#lib/*": "./src/lib/*"
  },
  "scripts": {
    "dev": "vite dev",
    "dev:share": "vite dev --host 0.0.0.0 --port 5173",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check:questions": "node --disable-warning=ExperimentalWarning scripts/check-questions.ts",
    "db:up": "docker compose up -d db",
    "db:migrate": "node --disable-warning=ExperimentalWarning scripts/migrate.ts",
    "db:migrate:test": "node --disable-warning=ExperimentalWarning scripts/migrate.ts --test",
    "start": "node --disable-warning=ExperimentalWarning server.ts",
    "purge:unverified": "node --disable-warning=ExperimentalWarning scripts/purge-unverified.ts",
    "backup:db": "./scripts/backup-db.sh"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@sveltejs/adapter-node": "6.0.0",
    "@sveltejs/kit": "3.0.1",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/qrcode": "1.5.6",
    "@types/ws": "8.18.2",
    "svelte": "5.57.2",
    "svelte-check": "4.7.6",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  },
  "dependencies": {
    "chess.js": "1.4.0",
    "openskill": "5.0.1",
    "pg": "8.23.1",
    "qrcode": "1.5.4",
    "ws": "8.22.0"
  }
}

# Postgres container (docker-compose.yml)
POSTGRES_USER=domaci_liga
POSTGRES_PASSWORD=change-me

# App + migrations (node scripts/migrate.ts)
DATABASE_URL=postgres://domaci_liga:change-me@127.0.0.1:5437/domaci_liga
# Tests (Vitest) and `node scripts/migrate.ts --test`; the database name must contain `_test`.
DATABASE_URL_TEST=postgres://domaci_liga:change-me@127.0.0.1:5437/domaci_liga_test

# Signs the household login cookie (any long random string, e.g. `openssl rand -hex 32`).
HOUSEHOLD_COOKIE_SECRET=change-me-to-a-long-random-string

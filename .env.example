# Postgres container (docker-compose.yml)
POSTGRES_USER=domaci_liga
POSTGRES_PASSWORD=change-me

# App + migrations (node scripts/migrate.ts)
DATABASE_URL=postgres://domaci_liga:change-me@127.0.0.1:5437/domaci_liga
# Tests (Vitest) and `node scripts/migrate.ts --test`; the database name must contain `_test`.
DATABASE_URL_TEST=postgres://domaci_liga:change-me@127.0.0.1:5437/domaci_liga_test

# Signs the household login cookie (any long random string, e.g. `openssl rand -hex 32`).
HOUSEHOLD_COOKIE_SECRET=change-me-to-a-long-random-string

# Public operation (see docs/PROVOZ.md). Empty = local network / dev.
# Public address: links in e-mails, Origin checks (CSRF, WebSocket), Secure cookies.
PUBLIC_ORIGIN=
# adapter-node: the same value as PUBLIC_ORIGIN behind a reverse proxy.
ORIGIN=
# 1 = behind a reverse proxy (trust X-Forwarded-For / X-Forwarded-Proto); XFF_DEPTH defaults to 1.
TRUST_PROXY=
# Tablet import can be larger than the adapter-node default of 512K.
BODY_SIZE_LIMIT=2M

# E-mail. Without SMTP_URL messages are written to MAIL_OUTBOX_DIR (dev: open the link from there).
# smtps://user:password@smtp.example.cz:465  or  smtp://user:password@smtp.example.cz:587 (STARTTLS)
SMTP_URL=
MAIL_FROM=Domácí liga <liga@example.cz>
MAIL_OUTBOX_DIR=data/outbox
